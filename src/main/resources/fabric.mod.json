  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "pnku"
  ],
  "contact": {
    "homepage": "https://www.pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Stick-Variants",
